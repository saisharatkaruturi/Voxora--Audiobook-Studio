# VOXORA backend configuration.
# Copy to backend/.env and adjust. Every value is optional; the defaults run
# fully locally (SQLite, local files, Piper voices, RapidOCR, local embeddings).
# Never commit your real .env.

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
HOST=127.0.0.1                     # use 0.0.0.0 to serve your LAN (friends on the same Wi-Fi)
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false                     # structured JSON logs (for production log shipping)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Security -------------------------------------------------------------------
# SECRET_KEY signs login tokens and media URLs. Auto-generated into data/.secret_key when unset.
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=20160     # 14 days
MEDIA_URL_TTL_SECONDS=21600        # signed audio/download links expire after 6 hours
ALLOW_REGISTRATION=true            # false = only the first (admin) account can register
RATE_LIMIT_ENABLED=true

# --- Accounts: Supabase Auth ------------------------------------------------------
# Set SUPABASE_URL to sign in through Supabase (email/password, magic links, Google...)
# instead of VOXORA's built-in accounts. Both values are in Supabase -> Project Settings -> API.
# AUTH_PROVIDER=auto               # auto (Supabase when SUPABASE_URL is set) | local | supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon or publishable key>   # public; given to the browser
# SUPABASE_JWT_SECRET=             # only for projects on the legacy HS256 JWT secret
# ADMIN_EMAILS=you@example.com     # comma-separated; these accounts become admins
# SUPABASE_OAUTH_PROVIDERS=google   # sign-in buttons; enable each in Supabase -> Authentication -> Providers
# With Supabase, ALLOW_REGISTRATION=false lets in only existing accounts and ADMIN_EMAILS.
# Existing VOXORA accounts are linked by email the first time they sign in through
# Supabase (after Supabase has confirmed the address).

# --- Database -------------------------------------------------------------------
# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./data/studio.db
# PostgreSQL / Supabase Postgres. Use the pooler URI from Supabase -> Connect
# ("Transaction pooler", port 6543) and swap the scheme for postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Copy an existing SQLite library across with scripts/migrate_sqlite_to_postgres.py

# --- Storage --------------------------------------------------------------------
# Where finished audiobooks live:
#   server: in STORAGE_PATH / S3 (the server keeps every audiobook)
#   device: in each listener's browser; the server deletes a chapter as soon as the
#           browser has it, and sweeps uncollected audio after DEVICE_HANDOFF_TTL_HOURS
AUDIO_DELIVERY=server
# DEVICE_HANDOFF_TTL_HOURS=24
STORAGE_PROVIDER=local             # local | s3
# STORAGE_PATH=./data/storage
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO...; pip install boto3):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_FILE_SIZE_MB=300
MAX_PAGES=5000
MIN_FREE_DISK_MB=500
TEMP_FILE_TTL_HOURS=24

# --- Background jobs --------------------------------------------------------------
# Jobs are stored in the database. By default the worker runs inside the API
# process; set false and run `python -m app.workers.runner` separately to scale out.
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
# REDIS_URL is not required: the durable queue lives in the database (see ARCHITECTURE.md).

# --- OCR ------------------------------------------------------------------------
OCR_PROVIDER=auto                  # auto | rapidocr | tesseract | easyocr
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DPI=300
OCR_LOW_CONFIDENCE_THRESHOLD=0.70

# --- Text to speech -------------------------------------------------------------------
TTS_PROVIDER=piper                 # piper (local) | sapi (Windows, local) | edge | openai | elevenlabs
TTS_ENABLED_PROVIDERS=piper,sapi,edge,openai,elevenlabs
PIPER_DEFAULT_VOICE=en_US-lessac-medium
# Generic cloud key (used when a provider-specific key is not set):
# TTS_API_KEY=
# OPENAI_TTS_API_KEY=
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible TTS server
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_TIMEOUT_SECONDS=120
TTS_MAX_RETRIES=4

# --- Audio ------------------------------------------------------------------------
# FFMPEG_PATH=                     # defaults to the ffmpeg bundled with imageio-ffmpeg
AUDIO_SAMPLE_RATE=24000
AUDIO_DEFAULT_FORMAT=mp3           # mp3 | m4a | wav
AUDIO_DEFAULT_BITRATE=96k
AUDIO_TARGET_LUFS=-18

# --- AI: Ask the Book, summaries, AI Cast refinement ---------------------------------
LLM_PROVIDER=auto                  # auto | gemini | anthropic | ollama | openai | none
# auto = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else local Ollama.
# GEMINI_API_KEY=                  # https://aistudio.google.com/apikey (excerpts are sent to Google)
# GEMINI_MODEL=auto                # auto = newest stable Flash model; or pin e.g. gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=auto                  # auto = best installed local model; `ollama pull gemma3:4b`
# LLM_API_KEY=                     # for openai / anthropic
# LLM_BASE_URL=                    # OpenAI-compatible server (LM Studio, vLLM, OpenRouter...)
# LLM_MODEL=                       # overrides the provider's default model
LLM_TIMEOUT_SECONDS=600

EMBEDDING_PROVIDER=fastembed       # fastembed (local) | ollama | openai | hashing (no model download)
# EMBEDDING_MODEL=

# --- Privacy ------------------------------------------------------------------------
ANALYTICS_ENABLED=false            # no telemetry is collected; this flag is reserved for opt-in analytics
